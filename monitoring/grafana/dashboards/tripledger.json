          "legendFormat": "API p99",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tripledger_compute_duration_seconds_bucket[5m])))",
