        {
          "name": "Billable km",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('9.42 km', () => pm.expect(d.billableKm).to.eql('9.42'));",
                  "pm.test('2 road lookups, one per real gap', () => pm.expect(d.routing.requests + d.routing.replayed).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/trips/{{tripId}}/distance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips",
                "{{tripId}}",
                "distance"
              ]
            },
            "description": "Expect 9.42 km (naive 3.10 km) and 2 road lookups, one per real gap, through the drop point. The first run pays for 2 calls; repeat runs get them from the cache."
          }
        },
        {
          "name": "Breakdown: every segment has its rule",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2 routed pieces', () => pm.expect(pm.response.json().ruleCounts.ROUTED).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/trips/{{tripId}}/breakdown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips",
                "{{tripId}}",
                "breakdown"
              ]
            },
            "description": "23 SHORT_GAP_AERIAL pieces between pings, 2 ROUTED pieces for the gap (via the drop of EMP-2417), plus the cleaning report and the anchors used."
          }
        }
