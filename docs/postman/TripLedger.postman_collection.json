{
  "info": {
    "_postman_id": "f2b5e27c-32e5-5b46-a71f-fc9171531251",
    "name": "TripLedger demo",
    "description": "Run the folders in order (or the whole collection with the Runner) against a running TripLedger: `docker compose up -d --build`, or `mvn -pl app spring-boot:run`. Every request has tests that check the expected answer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    },
    {
      "key": "tripId",
      "value": ""
    },
    {
      "key": "tripB",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 Sign in",
      "item": [
        {
          "name": "Get a demo token (admin + operator)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now().toString(36).toUpperCase();",
                  "pm.collectionVariables.set('tripId', 'T-DEMO-' + run);",
                  "pm.collectionVariables.set('tripB', 'T-DEMO-' + run + '-B');",
                  "pm.collectionVariables.set('invoiceId', 'INV-' + run);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dev/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dev",
                "tokens"
              ]
            },
            "description": "Local only. Also picks fresh trip ids for this run, so the demo can be repeated on the same database.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant\": \"acme\",\n  \"subject\": \"demo\",\n  \"roles\": [\n    \"ADMIN\",\n    \"OPERATOR\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2 \u00b7 The underpass trip",
      "item": [
        {
          "name": "Upload the trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('computed straight away', () => pm.expect(pm.response.json().status).to.eql('COMPUTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{tripId}}-part-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/trips/{{tripId}}/evidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips",
                "{{tripId}}",
                "evidence"
              ]
            },
            "description": "24 pings, then 20 minutes without GPS (an underpass) during which employee EMP-2417 is dropped, then GPS is back 2 km east. Naive sum of pings: 3.10 km.",
