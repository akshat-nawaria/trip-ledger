                "type": "text/javascript",
                "exec": [
                  "const R = 6371008.8, MPD = R * Math.PI / 180;",
                  "const T0 = Date.parse('2026-10-29T18:00:00+05:30');",
                  "const ts = (s) => new Date(T0 + s * 1000).toISOString();",
                  "const office = { lat: 12.9698, lon: 77.75 + (6000 + Math.random() * 20000) / (MPD * Math.cos(12.9698 * Math.PI / 180)) };",
                  "const move = (p, n, e) => ({ lat: +(p.lat + n / MPD).toFixed(6), lon: +(p.lon + e / (MPD * Math.cos(p.lat * Math.PI / 180))).toFixed(6) });",
                  "const ping = (s, p, seq) => ({ ts: ts(s), lat: p.lat, lon: p.lon, accuracyM: 6, seq });",
                  "const pings = [];",
                  "for (let i = 0; i < 12; i++) pings.push(ping(5 * i, move(office, 50 * i, 0), i));",
                  "const last = move(office, 550, 0), drop = move(last, 3000, 1500), back = move(last, 0, 2000);",
                  "for (let j = 0; j < 12; j++) pings.push(ping(1255 + 5 * j, move(back, 50 * j, 0), 12 + j));",
                  "pm.variables.set('tripBBody', JSON.stringify({",
                  "  tripType: 'LOGOUT', windowStart: ts(-300), windowEnd: ts(7200), plannedOffice: office, pings,",
                  "  milestones: [{ type: 'TRIP_START', lat: office.lat, lon: office.lon, ts: ts(0) },",
                  "               { employeeRef: 'EMP-3086', type: 'DROP', lat: drop.lat, lon: drop.lon, ts: ts(655) }],",
                  "  plannedStops: [{ employeeRef: 'EMP-3086', riderType: 'PLANNED', lat: drop.lat, lon: drop.lon, plannedTs: ts(660) }]",
                  "}));"
                ]
